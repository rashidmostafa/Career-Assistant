# Copy to `.env` in the project root before running or building the app.
#
# ⚠️  EXPO_PUBLIC_* variables are inlined into the JS bundle at BUILD time.
#     They are NOT read at runtime — changing .env after an APK is built has
#     no effect, and the value is visible to anyone who unpacks the APK.
#     Never put a secret here. Rebuild after changing anything below.

# Base URL of the auth/API backend (server/). No trailing slash.
#
# This must be reachable from the DEVICE, on whatever network it is using.
# A LAN IP only works while the phone is on the same Wi-Fi as your PC, which
# is why builds stop working the moment you leave the house.
#
#   Production / any network:  https://career-assistant-api.onrender.com
#   Android emulator:          http://10.0.2.2:3001
#   Physical device, same LAN: http://192.168.x.x:3001   (breaks off-network)
#
# Leave blank to run the app against its built-in offline simulation.
EXPO_PUBLIC_API_URL=

# Optional: enables AI-powered CV analysis, roadmap generation, and interview
# feedback via OpenAI. If left unset, the app automatically falls back to
# built-in heuristic scoring/generation, so it will still run without this.
EXPO_PUBLIC_OPENAI_API_KEY=

# ── Hawk AI (self-hosted, services/hawkClient.ts) ─────────────────────────
# Base URL of the Hawk inference server (Hawk/serve_hawk.sh). No trailing slash.
#
# Hawk covers only the six tasks it was fine-tuned on — CV parsing, skill
# extraction, job matching, ATS scoring, roadmaps, interview questions. Cover
# letters, CV rewrites and answer scoring stay on EXPO_PUBLIC_OPENAI_API_KEY
# above; Hawk was measured to be worse than its own base model at those.
#
# Same LAN caveat as EXPO_PUBLIC_API_URL: this must be reachable from the
# DEVICE. Your machine has to be running serve_hawk.sh.
#
#   Physical device, same LAN: http://192.168.0.8:8000
#   Android emulator:          http://10.0.2.2:8000
#
# Leave blank to disable Hawk entirely — every call then returns null and the
# app falls back to its deterministic logic.
EXPO_PUBLIC_HAWK_URL=

# Per-request timeout in ms. The 0.5B model answers most tasks in well under a
# second on GPU, but NLP Analyzer and Roadmap generate ~800 tokens.
EXPO_PUBLIC_HAWK_TIMEOUT_MS=20000
