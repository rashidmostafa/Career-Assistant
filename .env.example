# Copy to `.env` in the project root before running or building the app.
#
# ⚠️  EXPO_PUBLIC_* variables are inlined into the JS bundle at BUILD time.
#     They are NOT read at runtime — changing .env after an APK is built has
#     no effect, and the value is visible to anyone who unpacks the APK.
#     Never put a secret here. Rebuild after changing anything below.

# Base URL of the auth/API backend (server/). No trailing slash.
#
# This must be reachable from the DEVICE, on whatever network it is using.
# A LAN IP only works while the phone is on the same Wi-Fi as your PC, which
# is why builds stop working the moment you leave the house.
#
#   Production / any network:  https://career-assistant-api.onrender.com
#   Android emulator:          http://10.0.2.2:3001
#   Physical device, same LAN: http://192.168.x.x:3001   (breaks off-network)
#
# Leave blank to run the app against its built-in offline simulation.
EXPO_PUBLIC_API_URL=

# ── AI ────────────────────────────────────────────────────────────────────
# There is no AI key in the app. Every model call — the general-purpose LLM
# (services/aiClient.ts) and the self-hosted Hawk model
# (services/hawkClient.ts) — goes through the backend at EXPO_PUBLIC_API_URL,
# which holds the keys and forwards the request. Configure the provider on the
# SERVER instead: AI_API_KEY, AI_BASE_URL, AI_MODEL, HAWK_URL, HAWK_SECRET
# (see server/.env.example and render.yaml).
#
# Leave EXPO_PUBLIC_API_URL blank and every AI call returns null, which the
# app handles by falling back to its built-in deterministic logic.

# Optional: per-request timeouts in ms for the two AI paths. Generous by
# design — the first request may have to wake a spun-down backend before the
# model is even called. Defaults shown.
EXPO_PUBLIC_AI_TIMEOUT_MS=45000
EXPO_PUBLIC_HAWK_TIMEOUT_MS=60000

# Optional: how long (ms) the app waits after the last local change before
# pushing it to the backend (services/syncedStorage.ts). Default shown.
EXPO_PUBLIC_SYNC_DEBOUNCE_MS=1500
