{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NPM_FLAGS": "--legacy-peer-deps"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NPM_FLAGS": "--legacy-peer-deps",
        "EXPO_PUBLIC_API_URL": "https://career-assistant-api-pkc0.onrender.com"
      }
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "NPM_FLAGS": "--legacy-peer-deps"
      }
    },
    "ios-adhoc": {
      "distribution": "internal",
      "ios": {
        "enterpriseProvisioning": "adhoc"
      },
      "env": {
        "NPM_FLAGS": "--legacy-peer-deps",
        "EXPO_PUBLIC_API_URL": "https://career-assistant-api-pkc0.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "NPM_FLAGS": "--legacy-peer-deps",
        "EXPO_PUBLIC_API_URL": "https://career-assistant-api-pkc0.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
