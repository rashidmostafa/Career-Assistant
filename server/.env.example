# Career Assistant — Auth Server environment variables
# Copy to server/.env and fill in values before starting

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Public base URL of this server (used for OAuth callback URLs registered
# with Google/LinkedIn — NOT the mobile deep link).
# No trailing slash.
#
# Development: use your ngrok URL
#   SERVER_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
# Production:
#   SERVER_BASE_URL=https://api.yourapp.com
SERVER_BASE_URL=

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=
# Production example: mongodb+srv://user:pass@cluster.mongodb.net/career-assistant?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# (SESSION_SECRET is no longer needed — express-session was removed; the OAuth
#  redirect URI travels in a JWT_SECRET-signed `state` parameter instead.)

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave blank to allow all in dev)
ALLOWED_ORIGINS=
# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
#
# Authorised redirect URI (add this in the Google Console):
#   <SERVER_BASE_URL>/api/auth/google/callback
#   e.g. https://your-ngrok-subdomain.ngrok-free.app/api/auth/google/callback
#
# NOTE: Do NOT add the mobile deep link (career-assistant:// or exp://) as a
# redirect URI in the Google Console. The server handles the OAuth callback;
# the server then redirects to the mobile deep link itself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Deep link fallback (used when client does not pass ?redirectUri=) ──────────
# This is the fallback for production standalone builds.
# Must match the scheme in app.json. Keep the trailing slash.
# In practice the mobile client passes its own redirectUri as a query param,
# so this is only used as a last-resort fallback.
APP_DEEP_LINK=career-assistant://

# ── Email (choose one provider) ───────────────────────────────────────────────
# Gmail HTTP API — the working option when you have no domain of your own.
# Managed hosts block outbound SMTP (25/465/587), and Brevo/SendGrid/Resend all
# refuse an @gmail.com sender under DMARC. Sending through Gmail avoids both.
#   1. Google Cloud -> APIs & Services -> Library -> enable "Gmail API"
#   2. Credentials -> your OAuth client -> Authorised redirect URIs ->
#      add  http://localhost:53682/
#   3. cd server && node get-gmail-token.js   (prints GMAIL_REFRESH_TOKEN)
# While the consent screen is in "Testing" mode the refresh token expires
# after 7 days; publish the app to stop that.
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=

# Brevo HTTP API — needs a domain you can authenticate. Blocked for
# outbound SMTP ports (25/465/587). SMTP there times out no matter how valid
# the credentials are. Free tier: 300 emails/day, no domain needed.
#   1. brevo.com -> sign up
#   2. Senders & IPs -> add your Gmail as a sender, click the confirmation email
#   3. SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=
BREVO_FROM_EMAIL=


# SendGrid
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Or Nodemailer SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password

# ── Push Notifications ────────────────────────────────────────────────────────
# Option A: Expo Push API (simplest for Expo managed workflow)
EXPO_ACCESS_TOKEN=your-expo-access-token

# Option B: Firebase Admin SDK (bare React Native / production FCM)
# Paste the JSON content of your Firebase service account key file:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── AI provider (general-purpose LLM) ────────────────────────────────────────
# Every model call the app makes is proxied through /api/ai/chat, so the key
# lives here and never ships inside the APK. Any OpenAI-compatible endpoint
# works; the default is Gemini through its OpenAI-format gateway. Changing the
# provider or model is a config edit, not an app rebuild.
#
# Leave AI_API_KEY blank and /api/ai/chat returns data:null, which every
# caller in the app handles by falling back to its deterministic logic.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
# Upstream timeout in ms. CV scoring and roadmap generation take ~25s warm,
# and a spun-down instance adds ~20s before the model is reached.
AI_TIMEOUT_MS=120000

# ── Hawk (self-hosted fine-tuned model) ──────────────────────────────────────
# Base URL of serve_hawk.py, as reachable from THIS server — a LAN address in
# development, a tunnel or cloud host in production. No trailing slash.
# Leave blank to disable Hawk; /api/ai/hawk/* then returns data:null and the
# app falls back. See docs/HAWK_INTEGRATION.md.
HAWK_URL=
# Sent upstream as X-Hawk-Secret. serve_hawk.py has no authentication of its
# own, so set this before exposing it beyond the LAN.
HAWK_SECRET=
HAWK_TIMEOUT_MS=60000

# ── Careerjet (Bangladesh job listings) ──────────────────────────────────────
# Publisher API key from careerjet.com/partners/api. Left unset,
# /api/jobs/search returns an empty list and the feed carries remote and
# international roles only.
CAREERJET_API_KEY=
# Careerjet rejects requests whose Referer is not the publisher site registered
# against the key.
CAREERJET_REFERER=
# locale_code sent with every query. An unsupported value returns HTTP 400
# rather than an empty result.
CAREERJET_LOCALE=en_BD
CAREERJET_TIMEOUT_MS=15000
