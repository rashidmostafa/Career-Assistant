# Career Assistant — Auth Server environment variables
# Copy to server/.env and fill in values before starting

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Public base URL of this server (used for OAuth callback URLs)
# No trailing slash. Example: https://api.yourapp.com
SERVER_BASE_URL=http://localhost:3001

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/career-assistant
# Production example: mongodb+srv://user:pass@cluster.mongodb.net/career-assistant?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# ── Session secret (Passport OAuth state cookie) ──────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave blank to allow all in dev)
ALLOWED_ORIGINS=http://localhost:8081,https://your-app.com

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI must be: ${SERVER_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── LinkedIn OAuth2 ───────────────────────────────────────────────────────────
# Create at: https://www.linkedin.com/developers/apps
# Authorised redirect URI must be: ${SERVER_BASE_URL}/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ── Deep link (OAuth callback + password-reset email) ─────────────────────────
# Must match the scheme in app.json. Keep the trailing slash.
APP_DEEP_LINK=career-assistant://

# ── Email (choose one provider) ───────────────────────────────────────────────
# SendGrid
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Or Nodemailer SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password

# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15550000000

# ── Push Notifications ────────────────────────────────────────────────────────
# Option A: Expo Push API (simplest for Expo managed workflow)
EXPO_ACCESS_TOKEN=your-expo-access-token

# Option B: Firebase Admin SDK (bare React Native / production FCM)
# Paste the JSON content of your Firebase service account key file:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Client app ────────────────────────────────────────────────────────────────
# Set this in your Expo project's .env (not in server/.env):
# EXPO_PUBLIC_API_URL=http://localhost:3001
